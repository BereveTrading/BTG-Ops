# Copy to offsite.env and chmod 600. offsite.env is gitignored (*.env).
# Nothing here is filled in — offsite-push.sh stays inert until it is.

# rclone remote and bucket/path, in rclone's "remote:path" form.
# Create the remote first with `rclone config` and name it btg-offsite.
#   Backblaze B2 example: btg-offsite:btg-db-offsite
#   AWS S3 example:       btg-offsite:my-btg-bucket/db
BTG_OFFSITE_REMOTE=

# Encrypt before upload (1 = yes, strongly recommended, default).
# The dump is the whole market database; globals-*.sql contains role password
# hashes. Neither belongs in a bucket in the clear.
BTG_OFFSITE_ENCRYPT=1

# File containing the symmetric passphrase used by gpg (AES256).
# Create it with something long and random, e.g.:
#     openssl rand -base64 48 > /home/dean/btg/ops/db-backup/offsite.passphrase
#     chmod 600 /home/dean/btg/ops/db-backup/offsite.passphrase
#
# *** THEN COPY THAT PASSPHRASE INTO A PASSWORD MANAGER. ***
# If this machine dies and the passphrase died with it, the offsite copies are
# permanently unreadable and the whole exercise was pointless.
#
# To restore later:
#     gpg --batch --passphrase-file <file> --decrypt btg-YYYY-MM-DD.dump.gpg \
#         > btg-YYYY-MM-DD.dump
BTG_OFFSITE_PASSFILE=/home/dean/btg/ops/db-backup/offsite.passphrase
